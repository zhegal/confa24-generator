{
    "name": "confa24-screens-generator",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "typecheck": "vue-tsc --noEmit",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "vitest run",
        "format": "node scripts/format.mjs",
        "check:style": "node scripts/format-vue.mjs --check"
    },
    "dependencies": {
        "@lucide/vue": "^1.64.0",
        "vue": "^3.5.44",
        "vue-router": "^4.6.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "prettier": "^3.0.0",
        "typescript": "~5.9.0",
        "vite": "^8.3.5",
        "vitest": "^4.0.0",
        "vue-tsc": "^3.0.0",
        "@vue/compiler-dom": "^3.5.44"
    }
}
